# Pomegranate server configuration. Copy to .env and fill in what you need.
# Generated from src/platform/config.ts by `npm run env:example` — edit that
# file, not this one.
#
# A first local run needs only the uncommented lines below: an LLM provider
# and its key. Everything else has a working default. Sign-up is closed by
# default: create the first admin with `npm run create-admin -- --email you@example.com`.

# ── Runtime ───────────────────────────────────────────────────────────────
# default: 3000
PORT=3000
# SQLite only · default: ./data/pomegranate.db
# POMEGRANATE_DB_PATH=./data/pomegranate.db
# BlobStore fs driver root · default: ./data/files
# POMEGRANATE_FILES_DIR=./data/files
# MCP + OAuth issuer origin
PUBLIC_ORIGIN=http://localhost:3000
# links in emails / digests
PUBLIC_APP_URL=http://localhost:5173
# tracking links in update digests
# PUBLIC_API_URL=

# ── Drivers and feature flags ─────────────────────────────────────────────
# default: sqlite
# POMEGRANATE_DB_DRIVER=sqlite
# default: fs
# POMEGRANATE_BLOB_DRIVER=fs
# default: local
# POMEGRANATE_KEY_PROVIDER=local
# default: inproc
# POMEGRANATE_JOB_QUEUE=inproc
# default: 0
# POMEGRANATE_SEAL=0
# SURFACES=
# 0 disables claude.ai capability-URL connectors (OAuth only) · default: 1
# MCP_CAPABILITY_URLS=1
# required when POMEGRANATE_DB_DRIVER=pg · secret
# DATABASE_URL=
# required when POMEGRANATE_BLOB_DRIVER=azure (auth by managed identity)
# AZURE_STORAGE_ACCOUNT=
# required when POMEGRANATE_KEY_PROVIDER=azurekv
# AZURE_KEYVAULT_URL=
# required when POMEGRANATE_SEAL=1 and POMEGRANATE_KEY_PROVIDER=local; base64 of 32 random bytes · secret
# POMEGRANATE_LOCAL_KEK=

# ── LLM ───────────────────────────────────────────────────────────────────
# together | hosted (alias) | anthropic · default: together
POMEGRANATE_LLM_PROVIDER=anthropic
# POMEGRANATE_LLM_THINKING=
# provider=anthropic, wiki (preferAnthropic), surface agent · secret
ANTHROPIC_API_KEY=
# POMEGRANATE_CAPTURE_GLEAN=
# POMEGRANATE_CHUNK_CHARS=
# default: ./data/llm.log
# POMEGRANATE_LLM_LOG_PATH=./data/llm.log
# keep unset in production: the LLM log would then contain user text
# POMEGRANATE_LLM_LOG_VERBATIM=
# CURATOR_MODEL=
# SURFACE_AGENT_MODEL=
# SURFACE_AGENT_MAX_STEPS=
# SURFACE_AGENT_MAX_TOKENS=

# ── Hosted LLM (POMEGRANATE_LLM_PROVIDER=together or hosted) ──────────────
# provider=together|hosted — boot hard-fails if unset · secret
# POMEGRANATE_HOSTED_API_KEY=
# provider=together|hosted
# POMEGRANATE_HOSTED_BASE_URL=
# provider=together|hosted
# POMEGRANATE_HOSTED_MODEL=
# POMEGRANATE_HOSTED_CONCURRENCY=
# POMEGRANATE_HOSTED_RETRIES=
# POMEGRANATE_HOSTED_SCHEMA_MODE=
# POMEGRANATE_HOSTED_TEMP=
# POMEGRANATE_HOSTED_TIMEOUT_MS=
# POMEGRANATE_HOSTED_THINKING_TIMEOUT_MS=
# POMEGRANATE_HOSTED_EMBED_MODEL=
# POMEGRANATE_HOSTED_EMBED_DIM=

# ── Embeddings ────────────────────────────────────────────────────────────
# absent → StubEmbedder; also STT provider=openai · secret
# OPENAI_API_KEY=
# stub forces StubEmbedder
# POMEGRANATE_EMBEDDER=

# ── Speech-to-text (audio from WhatsApp and uploads) ──────────────────────
# openai | deepgram | munsit
# POMEGRANATE_STT_PROVIDER=
# POMEGRANATE_STT_MODEL=
# POMEGRANATE_STT_LANGUAGE=
# STT provider=deepgram · secret
# DEEPGRAM_API_KEY=
# STT provider=munsit · secret
# MUNSIT_API_KEY=

# ── Media storage (S3-compatible, optional) ───────────────────────────────
# POMEGRANATE_ASSET_BUCKET=
# POMEGRANATE_ASSET_ENDPOINT=
# POMEGRANATE_ASSET_REGION=
# POMEGRANATE_ASSET_PATH_STYLE=
# read implicitly by @aws-sdk, not by our code · secret
# AWS_ACCESS_KEY_ID=
# read implicitly by @aws-sdk, not by our code · secret
# AWS_SECRET_ACCESS_KEY=

# ── Logging ───────────────────────────────────────────────────────────────
# default: info
# POMEGRANATE_LOG_LEVEL=info
# set empty to log to stdout only · default: ./data/app.log
# POMEGRANATE_APP_LOG_PATH=./data/app.log

# ── Sign-in and sign-up ───────────────────────────────────────────────────
# open | closed · default: closed
# SIGNUP_MODE=closed
# shown to people without an account under closed signup
# CONTACT_EMAIL=
# tests/local dev only: return sign-in codes in API responses when no mailer is set; NEVER on a reachable server
# POMEGRANATE_DEV_INLINE_CODES=
# one implicit local identity, no sign-in; NEVER on a reachable server
# POMEGRANATE_SINGLE_USER=
# number of reverse proxies in front of the server; set 1 behind one proxy so rate limits and audit logs see the real client IP · default: 0
# POMEGRANATE_TRUSTED_PROXY_HOPS=0
# POMEGRANATE_AUTH_RL_CAPACITY=
# POMEGRANATE_AUTH_RL_REFILL_MS=
# failed credential checks (session, MCP token, connector, SCIM, surface secret) allowed per client IP before 429 · default: 30
# POMEGRANATE_AUTH_FAIL_RL_CAPACITY=30
# ms to regain one failed-check allowance · default: 2000
# POMEGRANATE_AUTH_FAIL_RL_REFILL_MS=2000
# encrypts per-user app credentials at rest · secret
# POMEGRANATE_CREDENTIALS_KEY=
# POMEGRANATE_ORG_EMAIL_DOMAINS=
# POMEGRANATE_PERSONAL_EMAIL_DOMAINS=

# ── Mail (sign-in links, invites, password resets) ────────────────────────
# secret
# RESEND_API_KEY=
# sender address; required with RESEND_API_KEY
# MAIL_FROM=
# URL carries credentials · secret
# SMTP_URL=

# ── Slack and WhatsApp bots ───────────────────────────────────────────────
# shared secret for bot → API relay calls · secret
# SURFACE_AGENT_SECRET=
# update delivery to Slack · secret
# SLACK_BOT_TOKEN=
# secret
# UPDATES_SLACK_TOKEN=

# ── Schedulers ────────────────────────────────────────────────────────────
# 1 = run the 60 s Get-updates scheduler tick
# UPDATES_SCHEDULER=
# 1 = run the 60 s automations scheduler tick
# AUTOMATIONS_SCHEDULER=

# ── Retrieval tuning ──────────────────────────────────────────────────────
# POMEGRANATE_SOURCE_RAG=
# POMEGRANATE_SOURCE_RAG_K=
# POMEGRANATE_SOURCE_RAG_MIN_SIM=
# POMEGRANATE_SOURCE_RAG_PER_DOC=
# POMEGRANATE_SOURCE_CHUNK_CHARS=
# POMEGRANATE_SOURCE_CHUNK_OVERLAP_PCT=

# ── App connectors (Composio) ─────────────────────────────────────────────
# secret
# COMPOSIO_API_KEY=
# Slack bot token for update deliveries, used when SLACK_BOT_TOKEN is unset · secret
# POMEGRANATE_SLACK_TOKEN=

# ── Phase 0 CLI ───────────────────────────────────────────────────────────
# POMEGRANATE_DATA_DIR=
