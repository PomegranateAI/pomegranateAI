# WasenderAPI (https://wasenderapi.com) session credentials — from the
# Wasender dashboard, Session Management screen, after connecting a WhatsApp
# number. This bot answers as THAT number: whoever messages it is identified
# by their own phone number (see README.md "How identity resolves").
WASENDER_API_TOKEN=...
# Override only if Wasender's docs point you at a different host for your
# account; defaults to the one documented at wasenderapi.com/api-docs.
#WASENDER_API_BASE_URL=https://www.wasenderapi.com/api

# Shared secret configured in the Wasender dashboard's Webhook URL field
# alongside https://<your-domain>/whatsapp/webhook. Wasender echoes it back
# verbatim in the X-Webhook-Signature header on every delivery; requests
# without a matching header are rejected with 401.
WASENDER_WEBHOOK_SECRET=...

# ---- relay mode (the only mode this surface runs) ----
# Every message is forwarded to the app's LLM surface agent
# (POST /agent/surface/messages, surface=whatsapp); user identity resolves
# SERVER-side from the phone numbers people link in Setup -> Your profile.
# One shared secret — the same value must be set as SURFACE_AGENT_SECRET on
# the app server.
POMEGRANATE_API_URL=http://localhost:3000
SURFACE_AGENT_SECRET=...

# Audio/image reading runs on the Pomegranate server. Configure its provider
# credentials there; no STT or model API keys are needed in this container.

# PORT=3002
