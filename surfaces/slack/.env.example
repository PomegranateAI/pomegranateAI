# Slack app credentials
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...        # socket mode (dev)
SLACK_MODE=socket               # socket | http

# Path to the surface<->Pomegranate mapping (see config/mapping.example.json).
# In relay mode only the `teams` section is used (team id -> API base URL);
# per-user entries are legacy-mode only.
POMEGRANATE_SLACK_CONFIG=./config/mapping.json

# ---- relay mode (default when the secret is set) ----
# The surface forwards messages to the app's LLM surface agent
# (POST /agent/surface/messages); user identity resolves SERVER-side from the
# Slack identities people link in Setup -> Your profile. One shared secret --
# the same value must be set as SURFACE_AGENT_SECRET on the app server.
SURFACE_AGENT_SECRET=...

# Rollback switch for one deploy cycle: force the old regex-verb pipeline
# (requires the per-user token entries below).
#SLACK_AGENT_MODE=legacy

# ---- legacy mode only: one MCP bearer per mapped subject-workspace,
# referenced by the `mcp_token_env` name in mapping.json ----
#POMEGRANATE_WS_ALICE_TOKEN=...
#POMEGRANATE_WS_SAM_TOKEN=...
